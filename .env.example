# Google Cloud project that has the Vertex AI API enabled
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=global
# Gemini model on Vertex AI
GEMINI_MODEL=gemini-3.8-flash
# Port for the Express server (Cloud Run sets this for you)
PORT=8080
# Convex deployment URL (required: sign-in and storage run on Convex).
# `npx convex dev` writes VITE_CONVEX_URL to .env.local for you;
# on Cloud Run set CONVEX_URL instead (the browser reads it from /api/config).
# CONVEX_URL=https://your-deployment.convex.cloud
# Optional: only needed if your Convex HTTP actions URL isn't the default <name>.convex.site
# CONVEX_SITE_URL=https://your-deployment.convex.site
