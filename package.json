{
  "name": "planwell-ai",
  "version": "1.0.0",
  "private": true,
  "description": "PlanWell.AI — an AI-assisted event planner (React + Express on Cloud Run, Gemini on Vertex AI, Convex for persistence)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c auto \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p convex/tsconfig.json",
    "dev:convex": "convex dev"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "@google/genai": "^2.30.0",
    "convex": "^1.47.0",
    "express": "^5.3.0",
    "jose": "^6.2.13",
    "read-excel-file": "^9.3.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.5"
  }
}
